# 生产部署私域配置
# 首次使用：cp ops/deploy.env.example ops/deploy.env 后按实际填写
# deploy.env 已 gitignore，含服务器地址等隐私信息，绝不提交公开仓库

# ssh 目标。建议在 ~/.ssh/config 配 Host 别名 + 密钥登录，这里只写别名
SERVER="mms-prod"

# 服务器上项目根目录（含 docker-compose.yml 和 .env）
APP_DIR="/opt/mms"

# 健康检查地址（反代入口域名）
SITE_URL="https://demo.example.com"

# 服务器上部署快照目录（与 ops/backup_pg.sh 的 BACKUP_DIR 保持一致）
BACKUP_DIR="/backups/mms"

# 服务器上 PG 容器名（1Panel 安装的一般不叫 postgres-server，用 docker ps 查）
PG_CONTAINER="postgres-server"

# PG 超级用户名（面板安装的可能不叫 postgres，容器内 env 的 POSTGRES_USER 为准）
PG_SUPERUSER="postgres"

# 业务库名（与服务器 .env 的 DB_NAME 一致）
DB_NAME="mms"

# 生产容器的运行身份。镜像在本机构建，这两个值必须与服务器上 compose 实际用的
# HOST_UID / HOST_GID 一致（服务器 .env 没配就是默认的 1000），否则镜像里
# usermod 出来的 uid 和 bind mount 的文件属主对不上，容器读不了自己的产物
PROD_UID="1000"
PROD_GID="1000"
