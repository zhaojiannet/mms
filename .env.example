# 部署模式：hosted（官方托管）/ self-hosted（社区自建）/ enterprise（私有部署）
# 宿主机 UID/GID（macOS 通常 501/20，Linux 通常 1000/1000）
# 容器内用户权限与宿主机一致，避免 bind mount 权限冲突
# 运行 `id` 查询你的值
HOST_UID=1000
HOST_GID=1000

DEPLOYMENT_MODE=self-hosted

# 应用
APP_PORT=8080

# PostgreSQL（使用通用容器，容器名 postgres 位于外部 docker-net 网络）
# 首次使用前需要在通用 PG 里创建 mms 数据库：
#   docker exec postgres psql -U postgres -c "CREATE DATABASE mms"
DB_HOST=postgres-server
DB_PORT=5432
DB_NAME=mms
DB_USER=mms
DB_PASSWORD=change_me_in_production
# TLS 模式：prefer（默认，可用就用）/ require / verify-full（生产跨网强制）
DB_SSLMODE=prefer
# 连接池规模（500 商户默认足够；大规模调大）
DB_MIN_CONNS=2
DB_MAX_CONNS=20
# 单 SQL 超时（ms）防慢查询拖爆 pool；报表聚合若超 5s 需 handler 覆盖
DB_STATEMENT_TIMEOUT=5000
# 应用仅用 DB_USER 连接，迁移也由 DB_USER 自行执行
# 首次 bootstrap（CREATE DATABASE mms OWNER mms）由运维一次性手工跑，不入本配置

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_ACCESS_TTL=24h
JWT_REMEMBER_TTL=168h

# 受信任反代白名单（CIDR，逗号分隔）
# 只有 RemoteAddr 属于此列表的请求才会读 X-Forwarded-For / X-Real-IP
# 直连部署（无反代）请留空，防 XFF 伪造绕过限流
# 1Panel OpenResty 反代部署示例：
#   TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Docker 部署在反代同主机：
#   TRUSTED_PROXIES=172.16.0.0/12,127.0.0.1/32
TRUSTED_PROXIES=

# 跨域白名单（逗号分隔的完整来源，含协议与端口）
# 留空 = 只放行 http://localhost:3001 和 :3000（开发便利）
# 生产走同源路径分流（NUXT_PUBLIC_API_BASE 留空）时浏览器不发跨域请求，无需配置；
# 只有前后端分域名部署才需要填，例如：
#   CORS_ALLOWED_ORIGINS=https://vip.example.com,https://admin.vip.example.com
CORS_ALLOWED_ORIGINS=

# 微信模板消息（通过 Cloudflare Workers 中转）
WXPUSH_URL=
WXPUSH_TOKEN=
WX_APPID=
WX_APPSECRET=

# 默认租户（首次启动 bootstrap admin，任一空即跳过）
# - BOOTSTRAP_TENANT_SLUG：已存在的 tenant（由 migration seed 建立），不自动建 tenant
# - BOOTSTRAP_ADMIN_NAME：可选，默认 "管理员"
BOOTSTRAP_TENANT_SLUG=demo
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change_me_on_first_login
BOOTSTRAP_ADMIN_NAME=管理员

# 产品主域名（不含子域）。用于拼出默认的运营后台主机名 admin.<APP_DOMAIN>
APP_DOMAIN=

# 运营后台的完整主机名（逗号分隔可多个）。一台机器跑多个项目、或想用不好猜的
# 名字时填这里，它优先于 APP_DOMAIN 拼出的默认值。
# 两者都留空才退回 admin. 前缀匹配（任意 admin.* 域名指到本机都能访问运营入口，不推荐）
# 只需配后端这一份：前端启动时问后端要判定结果，不另存一份主机名
PLATFORM_HOST=

# 平台操作员（运营后台 admin.<域名> 登录用）
# EMAIL 或 PASSWORD 为空即跳过创建；NAME 为空默认「运营」
# 账号建好后可清空这三项（幂等：已存在则跳过）；自建部署不需要运营后台的可不配置
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=

# 前端（Nuxt 运行时配置，经 compose env_file 注入）
# - NUXT_PUBLIC_API_BASE：生产留空（同源，由反代按 /api 路径分流）；开发填 http://localhost:8081
# - NUXT_PUBLIC_TENANT_SLUG：开发/自建单商户时的租户；hosted 生产按 Host 子域解析，不读此值
NUXT_PUBLIC_API_BASE=http://localhost:8081
NUXT_PUBLIC_APP_DOMAIN=vip.example.com
NUXT_PUBLIC_DEPLOYMENT_MODE=self-hosted
NUXT_PUBLIC_TENANT_SLUG=demo
